# --- Notion (source of truth) -------------------------------------------------
# Connection token with READ access to the Agent Skills database. REQUIRED.
# notion.so -> Settings -> Connections -> New connection -> name "Skills Sync"
#   -> authentication method "Access token" -> pick your workspace -> Create
#   -> copy the ntn_... value here.
# Then, in Notion, open the Agent Skills DB -> "..." menu -> Connections ->
#   Add connection -> "Skills Sync". Add it to the parent page too, otherwise
#   the first insert fails with "object not found".
# Workspace admins can silently block this: Settings -> Connections -> "Limit
#   who can create personal access tokens" / "Limit who can create internal
#   connections".
NOTION_API_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# prod (default) | dev | stg — flips the API host used by the sync.
NOTION_ENV=prod

# Data source id of the Agent Skills DB (run `npx --yes ntn datasources
# resolve <database-id>`). Recorded in each plugin's .notion-sync.json.
SKILLS_DATA_SOURCE_ID=

# --- Where the plugins are published -----------------------------------------
GITHUB_REPO=hbardet/agent-skills
GITHUB_BRANCH=main

# --- GitHub push credential ---------------------------------------------------
# Fine-grained PAT: Contents = Read and write, only the repo above, 1 year.
# https://github.com/settings/personal-access-tokens/new
# Orgs may require approval (Org settings -> Personal access tokens).
GITHUB_TOKEN=

# Optional: a GitHub App instead of the PAT. The private key goes on ONE line
# with literal \n escapes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional; looked up from GITHUB_REPO when empty.
GITHUB_APP_INSTALLATION_ID=

# --- Commit identity (optional) ----------------------------------------------
GIT_AUTHOR_NAME=my-skills
GIT_AUTHOR_EMAIL=my-skills@users.noreply.github.com
